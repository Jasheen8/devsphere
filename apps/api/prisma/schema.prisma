generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  FINALIZED
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SiteStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum RevealMethod {
  NORMAL
  QR
  PIN
  LETTER
  GIFT
  PUZZLE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  verifiedAt   DateTime?
  role         Role       @default(CUSTOMER)
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile      Profile?
  projects     Project[]
  orders       Order[]
  favorites    Favorite[]
  sessions     Session[]
  emailTokens   EmailToken[]
  auditLogs    AuditLog[]
}

model Profile {
  id        String @id @default(cuid())
  userId    String @unique
  phone     String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  templates Template[]
}

model Template {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  categoryId    String
  price         Int      @default(0)
  thumbnailUrl  String?
  previewUrl    String?
  liveDemoUrl   String?
  tags          String[]
  featured      Boolean  @default(false)
  premium       Boolean  @default(false)
  published     Boolean  @default(true)
  schema        Json
  defaultData   Json?
  sections      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id])
  templateSections TemplateSection[]
  templateFields   TemplateField[]
  projects         Project[]
  favorites        Favorite[]
}

model TemplateSection {
  id         String   @id @default(cuid())
  templateId String
  sectionKey String
  type       String
  title      String?
  sortOrder  Int      @default(0)
  props      Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model TemplateField {
  id         String  @id @default(cuid())
  templateId String
  fieldKey   String
  type       String
  label      String
  required   Boolean @default(false)
  sortOrder  Int     @default(0)
  config     Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  templateId    String
  name          String
  status        ProjectStatus  @default(DRAFT)
  data          Json
  customization Json
  revealMethod  RevealMethod  @default(NORMAL)
  finalizedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template         @relation(fields: [templateId], references: [id])
  website  PublishedSite?
  media    ProjectMedia[]
  orders   Order[]
  revisions ProjectRevision[]

  @@index([userId, updatedAt])
  @@index([templateId])
}

model ProjectRevision {
  id            String        @id @default(cuid())
  projectId     String
  data          Json
  customization Json
  status        ProjectStatus
  createdAt     DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectMedia {
  id         String   @id @default(cuid())
  projectId  String
  kind       String
  url        String
  storageKey  String
  mimeType   String
  size       Int?
  width      Int?
  height     Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model PublishedSite {
  id             String       @id @default(cuid())
  projectId      String       @unique
  slug           String       @unique
  status         SiteStatus   @default(ACTIVE)
  expiresAt      DateTime?
  revealMethod   RevealMethod  @default(NORMAL)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  customDomain   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessRule SiteAccessRule?
}

model SiteAccessRule {
  id               String  @id @default(cuid())
  siteId           String  @unique
  pinHash          String?
  puzzleQuestion   String?
  puzzleAnswerHash String?
  letterTitle      String?
  letterIntro      String?
  attempts         Int     @default(0)

  site PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  price       Int
  currency    String   @default("INR")
  description String?
  features    Json
  limits      Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  projectId       String
  planId          String
  amount          Int
  currency        String      @default("INR")
  status          OrderStatus @default(PENDING)
  provider        String      @default("razorpay")
  providerOrderId String?
  providerPaymentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  project Project     @relation(fields: [projectId], references: [id])
  plan    PricingPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([providerOrderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  status            PaymentStatus
  amount            Int
  currency          String
  providerPaymentId String?
  signature         String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerPaymentId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  templateId String?
  projectId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([templateId])
  @@index([projectId])
}