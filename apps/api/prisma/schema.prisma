generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  FINALIZED
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SiteStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum RevealMethod {
  NORMAL
  QR
  PIN
  LETTER
  GIFT
  PUZZLE
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateOfferStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AffiliateCommissionStatus {
  PENDING
  AVAILABLE
  RESERVED
  PAID
  DISPUTED
  REVERSED
  VOID
}

enum AffiliateLedgerEntryType {
  COMMISSION_PENDING_CREDIT
  COMMISSION_REVERSAL
  COMMISSION_RESTORATION
  PAYOUT_RESERVATION
  PAYOUT_RELEASE
  PAYOUT_DEBIT
  ADJUSTMENT
}

enum AffiliatePaymentAdjustmentKind {
  REFUND
  CHARGEBACK
}

enum AffiliatePaymentAdjustmentStatus {
  PENDING
  COMPLETED
  OPEN
  WON
  LOST
  CLOSED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  verifiedAt   DateTime?
  role         Role       @default(CUSTOMER)
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile      Profile?
  projects     Project[]
  orders       Order[]
  favorites    Favorite[]
  sessions     Session[]
  emailTokens   EmailToken[]
  auditLogs    AuditLog[]
  affiliateProfile AffiliateProfile?
}

model Profile {
  id        String @id @default(cuid())
  userId    String @unique
  phone     String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  templates Template[]
}

model Template {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  categoryId    String
  price         Int      @default(0)
  thumbnailUrl  String?
  previewUrl    String?
  liveDemoUrl   String?
  tags          String[]
  featured      Boolean  @default(false)
  premium       Boolean  @default(false)
  isFree        Boolean  @default(false)
  published     Boolean  @default(true)
  schema        Json
  defaultData   Json?
  sections      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id])
  templateSections TemplateSection[]
  templateFields   TemplateField[]
  projects         Project[]
  favorites        Favorite[]
  affiliateOffer   AffiliateOffer?
}

model TemplateSection {
  id         String   @id @default(cuid())
  templateId String
  sectionKey String
  type       String
  title      String?
  sortOrder  Int      @default(0)
  props      Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model TemplateField {
  id         String  @id @default(cuid())
  templateId String
  fieldKey   String
  type       String
  label      String
  required   Boolean @default(false)
  sortOrder  Int     @default(0)
  config     Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model Project {
  id            String        @id @default(cuid())
  userId        String
  templateId    String
  name          String
  status        ProjectStatus  @default(DRAFT)
  data          Json
  customization Json
  revealMethod  RevealMethod  @default(NORMAL)
  finalizedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template         @relation(fields: [templateId], references: [id])
  website  PublishedSite?
  media    ProjectMedia[]
  orders   Order[]
  revisions ProjectRevision[]

  @@index([userId, updatedAt])
  @@index([templateId])
}

model ProjectRevision {
  id            String        @id @default(cuid())
  projectId     String
  data          Json
  customization Json
  status        ProjectStatus
  createdAt     DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectMedia {
  id         String   @id @default(cuid())
  projectId  String
  kind       String
  url        String
  storageKey  String
  mimeType   String
  size       Int?
  width      Int?
  height     Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model PublishedSite {
  id             String       @id @default(cuid())
  projectId      String       @unique
  slug           String       @unique
  status         SiteStatus   @default(ACTIVE)
  expiresAt      DateTime?
  revealMethod   RevealMethod  @default(NORMAL)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  customDomain   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessRule SiteAccessRule?
}

model SiteAccessRule {
  id               String  @id @default(cuid())
  siteId           String  @unique
  pinHash          String?
  puzzleQuestion   String?
  puzzleAnswerHash String?
  letterTitle      String?
  letterIntro      String?
  attempts         Int     @default(0)

  site PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  price       Int
  currency    String   @default("INR")
  description String?
  features    Json
  limits      Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  projectId       String
  planId          String
  amount          Int
  currency        String      @default("INR")
  status          OrderStatus @default(PENDING)
  provider        String      @default("razorpay")
  providerOrderId String?
  providerPaymentId String?
  removeWatermark Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  project Project     @relation(fields: [projectId], references: [id])
  plan    PricingPlan @relation(fields: [planId], references: [id])
  payments Payment[]
  affiliateAttribution AffiliateAttribution?
  affiliateConversion AffiliateConversion?
  affiliateCommissions AffiliateCommission[]

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([providerOrderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  status            PaymentStatus
  amount            Int
  currency          String
  providerPaymentId String?
  signature         String?
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  affiliateConversion AffiliateConversion?
  affiliateAdjustments AffiliatePaymentAdjustment[]

  @@index([providerPaymentId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  templateId String?
  projectId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([templateId])
  @@index([projectId])
}

model AffiliateProfile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  status               AffiliateStatus @default(PENDING)
  referralSlug         String?         @unique
  acceptedTermsVersion String
  appliedAt            DateTime        @default(now())
  reviewedAt           DateTime?
  reviewedById         String?
  reviewReason         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user         User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  links        AffiliateReferralLink[]
  clicks       AffiliateClick[]
  attributions AffiliateAttribution[]
  conversions  AffiliateConversion[]
  commissions  AffiliateCommission[]
  ledgerEntries AffiliateLedgerEntry[]

  @@index([status, appliedAt])
}

model AffiliateProgramPolicy {
  id                      String   @id @default(cuid())
  version                 Int      @unique
  enabled                 Boolean  @default(false)
  defaultCommissionBps    Int      @default(2000)
  creatorMinCommissionBps Int      @default(1000)
  creatorMaxCommissionBps Int      @default(4000)
  attributionWindowDays   Int      @default(30)
  termsVersion            String   @default("phase1-v1")
  effectiveAt             DateTime @default(now())
  createdById             String?
  createdAt               DateTime @default(now())

  @@index([effectiveAt, version])
}

model ApiRateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@index([expiresAt])
}

model AffiliateOffer {
  id            String              @id @default(cuid())
  templateId    String              @unique
  commissionBps Int
  status        AffiliateOfferStatus @default(ACTIVE)
  startsAt      DateTime            @default(now())
  endsAt        DateTime?
  version       Int                 @default(1)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  template     Template                @relation(fields: [templateId], references: [id], onDelete: Restrict)
  links        AffiliateReferralLink[]
  attributions AffiliateAttribution[]
  conversions  AffiliateConversion[]

  @@index([status, startsAt, endsAt])
}

model AffiliateReferralLink {
  id                 String   @id @default(cuid())
  affiliateProfileId String
  offerId            String
  code               String   @unique
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  affiliateProfile AffiliateProfile      @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  offer            AffiliateOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  clicks           AffiliateClick[]
  attributions      AffiliateAttribution[]
  conversions       AffiliateConversion[]

  @@index([affiliateProfileId, createdAt])
  @@index([offerId, active])
}

model AffiliateClick {
  id                 String   @id @default(cuid())
  referralLinkId     String
  affiliateProfileId String
  visitorTokenHash   String
  clickedAt          DateTime @default(now())
  expiresAt          DateTime

  referralLink     AffiliateReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Restrict)
  affiliateProfile AffiliateProfile      @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  attributions     AffiliateAttribution[]

  @@index([referralLinkId, clickedAt])
  @@index([visitorTokenHash, clickedAt])
  @@index([affiliateProfileId, clickedAt])
}

model AffiliateAttribution {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  clickId            String
  affiliateProfileId String
  referralLinkId     String
  offerId            String
  commissionBps      Int
  offerVersion       Int
  policyVersion      Int
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  click            AffiliateClick        @relation(fields: [clickId], references: [id], onDelete: Restrict)
  affiliateProfile AffiliateProfile      @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  referralLink     AffiliateReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Restrict)
  offer            AffiliateOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  conversion       AffiliateConversion?

  @@index([affiliateProfileId, expiresAt])
  @@index([clickId])
}

model AffiliateConversion {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  paymentId           String   @unique
  attributionId       String   @unique
  affiliateProfileId  String
  referralLinkId      String
  offerId             String
  currency            String
  eligibleAmountMinor Int
  verifiedPaymentId   String
  convertedAt         DateTime @default(now())

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attribution      AffiliateAttribution  @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  affiliateProfile AffiliateProfile      @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  referralLink     AffiliateReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Restrict)
  offer            AffiliateOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  commission       AffiliateCommission?

  @@index([affiliateProfileId, convertedAt])
  @@index([offerId, convertedAt])
}

model AffiliateCommission {
  id                    String                    @id @default(cuid())
  conversionId          String                    @unique
  orderId               String
  affiliateProfileId    String
  currency              String
  eligibleAmountMinor   Int
  commissionBps         Int
  commissionAmountMinor Int
  reversedAmountMinor   Int                       @default(0)
  statusBeforeDispute   AffiliateCommissionStatus?
  offerVersion          Int
  policyVersion         Int
  status                AffiliateCommissionStatus @default(PENDING)
  createdAt             DateTime                  @default(now())

  conversion      AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  affiliateProfile AffiliateProfile    @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  ledgerEntries   AffiliateLedgerEntry[]

  @@index([affiliateProfileId, status, createdAt])
  @@index([orderId])
}

model AffiliatePaymentAdjustment {
  id                  String                            @id @default(cuid())
  paymentId           String
  provider            String
  externalId          String
  kind                AffiliatePaymentAdjustmentKind
  status              AffiliatePaymentAdjustmentStatus
  amountMinor         Int
  currency            String
  providerUpdatedAt   DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, kind, externalId])
  @@index([paymentId, kind, status])
}

model AffiliatePaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  receivedAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType, receivedAt])
}

model AffiliateLedgerEntry {
  id                 String                   @id @default(cuid())
  affiliateProfileId String
  commissionId       String?
  type               AffiliateLedgerEntryType
  amountMinor        Int
  currency           String
  idempotencyKey     String                   @unique
  reference          String?
  createdAt          DateTime                 @default(now())

  affiliateProfile AffiliateProfile     @relation(fields: [affiliateProfileId], references: [id], onDelete: Restrict)
  commission       AffiliateCommission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([affiliateProfileId, currency, createdAt])
  @@index([commissionId])
}
